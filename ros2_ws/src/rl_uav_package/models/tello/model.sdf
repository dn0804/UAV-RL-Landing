<?xml version="1.0" ?>
<!--
  DJI Tello model for RL training with realistic attitude dynamics.

  Uses Gazebo MulticopterMotorModel + MulticopterVelocityControl.
  Accepts Twist on cmd_vel, produces physical rotor forces/torques.

  Key physical parameters derived from real Tello specs:
    Mass:           87g total (85g body + 4×0.5g rotors)
    Propellers:     3" (76mm dia), 2-blade
    Motor-to-center:~63mm (at arm tips, NOT body edges)
    Max RPM:        ~28,650 (3000 rad/s)
    Hover RPM:      ~21,500 (2248 rad/s)
    Thrust/weight:  ~1.78
    Body dimensions: 98 × 92.5 × 41 mm (without prop guards)

  CHANGELOG from original:
  - rotorDragCoefficient: 6.63e-04 → 8.0e-06  (was ~100× too high for 87g)
  - rotorVelocitySlowdownSim: 20 → 10  (standard practice)
  - Motor positions: (±44,±42) → (±63,±63) mm  (arm tips, not body edges)
  - PID gains retuned for corrected physics
-->
<sdf version="1.8">
  <model name="tello">
    <link name="base_link">
      <pose>0 0 0.0205 0 0 0</pose>
      <inertial>
        <mass>0.085</mass>
        <inertia>
          <ixx>0.0000725</ixx>
          <iyy>0.0000799</iyy>
          <izz>0.0001286</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <geometry><box><size>0.098 0.0925 0.041</size></box></geometry>
      </collision>
      <visual name="base_visual">
        <geometry><box><size>0.098 0.0925 0.041</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
      </visual>

      <sensor name="front_camera" type="camera">
        <pose>0.049 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.43117</horizontal_fov>
          <image><width>960</width><height>720</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>100</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>camera/image_raw</topic>
      </sensor>

      <sensor name="downward_tof" type="gpu_lidar">
        <pose>0 0 -0.0205 0 1.570796 0</pose>
        <topic>tof_range</topic>
        <update_rate>15</update_rate>
        <ray>
          <scan>
            <horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
          </scan>
          <range><min>0.05</min><max>3.0</max><resolution>0.01</resolution></range>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>

    <!-- Rotor positions: real Tello motors sit at the tips of the arms,
         ~63mm from center in each axis (total frame ~180mm diagonal with
         prop guards).  DJI's "98 × 92.5 mm" spec is the central body
         WITHOUT prop guards — the arms extend well beyond.  -->

    <!-- Front-right (CCW) -->
    <link name="rotor_1">
      <pose>0.063 -0.063 0.025 0 0 0</pose>
      <inertial>
        <mass>0.0005</mass>
        <inertia><ixx>1.82e-07</ixx><iyy>1.82e-07</iyy><izz>3.63e-07</izz></inertia>
      </inertial>
      <visual name="rotor_1_visual">
        <geometry><cylinder><radius>0.0381</radius><length>0.005</length></cylinder></geometry>
        <material><ambient>0 0 0 1</ambient></material>
      </visual>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <child>rotor_1</child><parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><friction>0</friction></dynamics>
      </axis>
    </joint>

    <!-- Front-left (CW) -->
    <link name="rotor_2">
      <pose>0.063 0.063 0.025 0 0 0</pose>
      <inertial>
        <mass>0.0005</mass>
        <inertia><ixx>1.82e-07</ixx><iyy>1.82e-07</iyy><izz>3.63e-07</izz></inertia>
      </inertial>
      <visual name="rotor_2_visual">
        <geometry><cylinder><radius>0.0381</radius><length>0.005</length></cylinder></geometry>
        <material><ambient>0 0 0 1</ambient></material>
      </visual>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <child>rotor_2</child><parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><friction>0</friction></dynamics>
      </axis>
    </joint>

    <!-- Rear-left (CCW) -->
    <link name="rotor_3">
      <pose>-0.063 0.063 0.025 0 0 0</pose>
      <inertial>
        <mass>0.0005</mass>
        <inertia><ixx>1.82e-07</ixx><iyy>1.82e-07</iyy><izz>3.63e-07</izz></inertia>
      </inertial>
      <visual name="rotor_3_visual">
        <geometry><cylinder><radius>0.0381</radius><length>0.005</length></cylinder></geometry>
        <material><ambient>0.5 0.5 0.5 1</ambient></material>
      </visual>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <child>rotor_3</child><parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><friction>0</friction></dynamics>
      </axis>
    </joint>

    <!-- Rear-right (CW) -->
    <link name="rotor_4">
      <pose>-0.063 -0.063 0.025 0 0 0</pose>
      <inertial>
        <mass>0.0005</mass>
        <inertia><ixx>1.82e-07</ixx><iyy>1.82e-07</iyy><izz>3.63e-07</izz></inertia>
      </inertial>
      <visual name="rotor_4_visual">
        <geometry><cylinder><radius>0.0381</radius><length>0.005</length></cylinder></geometry>
        <material><ambient>0.5 0.5 0.5 1</ambient></material>
      </visual>
    </link>
    <joint name="rotor_4_joint" type="revolute">
      <child>rotor_4</child><parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><friction>0</friction></dynamics>
      </axis>
    </joint>

    <!-- ═══════════════════════════════════════════════════════════
         Motor model plugins — one per rotor.

         Key fix: rotorDragCoefficient was 6.63e-04 (copied from a
         ~3.5 kg reference drone).  On an 87g Tello this produced
         68 m/s² of translational drag per m/s of body velocity —
         nearly 7g — making the velocity controller fight itself
         into oscillation and crash.  Corrected to 8.0e-06, which
         gives ~0.08g per m/s (matching the drag-to-weight ratio
         of the reference drone scaled to Tello mass).

         rotorVelocitySlowdownSim reduced from 20 to 10 (standard).
         ═══════════════════════════════════════════════════════════ -->

    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>model/tello</robotNamespace>
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>ccw</turningDirection>
      <maxRotVelocity>3000</maxRotVelocity>
      <motorConstant>4.22e-08</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <rotorDragCoefficient>8.0e-06</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-07</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <actuator_number>0</actuator_number>
      <motorType>velocity</motorType>
    </plugin>

    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>model/tello</robotNamespace>
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <maxRotVelocity>3000</maxRotVelocity>
      <motorConstant>4.22e-08</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <rotorDragCoefficient>8.0e-06</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-07</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <actuator_number>1</actuator_number>
      <motorType>velocity</motorType>
    </plugin>

    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>model/tello</robotNamespace>
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <turningDirection>ccw</turningDirection>
      <maxRotVelocity>3000</maxRotVelocity>
      <motorConstant>4.22e-08</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <rotorDragCoefficient>8.0e-06</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-07</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <actuator_number>2</actuator_number>
      <motorType>velocity</motorType>
    </plugin>

    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>model/tello</robotNamespace>
      <jointName>rotor_4_joint</jointName>
      <linkName>rotor_4</linkName>
      <turningDirection>cw</turningDirection>
      <maxRotVelocity>3000</maxRotVelocity>
      <motorConstant>4.22e-08</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <rotorDragCoefficient>8.0e-06</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-07</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <actuator_number>3</actuator_number>
      <motorType>velocity</motorType>
    </plugin>

    <!-- ═══════════════════════════════════════════════════════════
         Velocity controller — cascaded PID:
           velocity error → desired attitude  (velocityGain)
           attitude error → desired ang rate  (attitudeGain)
           ang rate error → motor deltas      (angularRateGain)

         Gains tuned conservatively for 87g drone with corrected
         drag.  If the drone feels sluggish, increase velocityGain
         first.  If it oscillates, reduce attitudeGain.
         ═══════════════════════════════════════════════════════════ -->

    <plugin filename="gz-sim-multicopter-control-system"
            name="gz::sim::systems::MulticopterVelocityControl">
      <robotNamespace>model/tello</robotNamespace>
      <commandSubTopic>cmd_vel</commandSubTopic>
      <enableSubTopic>enable</enableSubTopic>
      <comLinkName>base_link</comLinkName>
      <velocityGain>1.0 1.0 0.8</velocityGain>
      <attitudeGain>0.1 0.1 0.05</attitudeGain>
      <angularRateGain>0.03 0.03 0.02</angularRateGain>
      <rotorConfiguration>
        <rotor>
          <jointName>rotor_1_joint</jointName>
          <forceConstant>4.22e-08</forceConstant>
          <momentConstant>0.016</momentConstant>
          <direction>1</direction>
        </rotor>
        <rotor>
          <jointName>rotor_2_joint</jointName>
          <forceConstant>4.22e-08</forceConstant>
          <momentConstant>0.016</momentConstant>
          <direction>-1</direction>
        </rotor>
        <rotor>
          <jointName>rotor_3_joint</jointName>
          <forceConstant>4.22e-08</forceConstant>
          <momentConstant>0.016</momentConstant>
          <direction>1</direction>
        </rotor>
        <rotor>
          <jointName>rotor_4_joint</jointName>
          <forceConstant>4.22e-08</forceConstant>
          <momentConstant>0.016</momentConstant>
          <direction>-1</direction>
        </rotor>
      </rotorConfiguration>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </model>
</sdf>